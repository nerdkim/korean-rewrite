{
  "name": "korean-rewrite",
  "version": "0.5.0",
  "description": "Claude Code용 한국어 글쓰기 skill과 hook 묶음입니다. Claude가 번역투 없이 업무 문서처럼 격식 있는 문어체로 쓰게 합니다. 검사기가 오류를 찾은 글은 hook이 파일, commit, PR에 남지 않게 막습니다.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerdkim/korean-rewrite.git"
  },
  "homepage": "https://github.com/nerdkim/korean-rewrite#readme",
  "bugs": {
    "url": "https://github.com/nerdkim/korean-rewrite/issues"
  },
  "bin": {
    "korean-rewrite": "scripts/install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "self-check": "node scripts/gate.mjs --self-check-only",
    "check": "node scripts/check-korean.mjs --all",
    "rules": "node scripts/check-korean.mjs --rules",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test test/*.test.mjs",
    "install-to": "node scripts/install.mjs",
    "eval": "node scripts/eval-korean.mjs"
  },
  "files": [
    "docs/rules.md",
    "docs/limits.md",
    "scripts/",
    "skill/",
    "agents/",
    "output-styles/"
  ],
  "keywords": [
    "korean",
    "style",
    "translationese",
    "honorific",
    "claude-code",
    "hooks"
  ]
}
