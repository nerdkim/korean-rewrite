{
  "name": "korean-rewrite",
  "version": "0.4.1",
  "description": "Claude Code에서 Claude가 번역투 대신 자연스러운 한국어를 쓰도록 한국어 작성 skill, 작성 agent, 문체 검사기, hook을 설치합니다.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerdkim/korean-rewrite.git"
  },
  "homepage": "https://github.com/nerdkim/korean-rewrite#readme",
  "bugs": {
    "url": "https://github.com/nerdkim/korean-rewrite/issues"
  },
  "bin": {
    "korean-rewrite": "scripts/install.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gate": "node scripts/gate.mjs",
    "self-check": "node scripts/gate.mjs --self-check-only",
    "check": "node scripts/check-korean.mjs --all",
    "rules": "node scripts/check-korean.mjs --rules",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test test/*.test.mjs",
    "install-to": "node scripts/install.mjs",
    "eval": "node scripts/eval-korean.mjs"
  },
  "files": [
    "docs/rules.md",
    "docs/limits.md",
    "scripts/",
    "skill/",
    "agents/",
    "output-styles/"
  ],
  "keywords": [
    "korean",
    "style",
    "translationese",
    "honorific",
    "claude-code",
    "hooks"
  ]
}
